# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

# Хост, на котором слушает HTTP-сервер
HTTP_HOST=${BONUS_HTTP_HOST}

# Порт HTTP-сервера
HTTP_PORT=${BONUS_HTTP_PORT}

# Таймаут чтения HTTP-запроса
HTTP_READ_TIMEOUT=${BONUS_HTTP_READ_TIMEOUT}

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${BONUS_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${BONUS_LOGGER_AS_JSON}


# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Хост PostgreSQL-сервера (для внутренних подключений)
POSTGRES_HOST=${BONUS_POSTGRES_HOST}

# Внутренний порт PostgreSQL
POSTGRES_PORT=${BONUS_POSTGRES_PORT}

# Внешний порт PostgreSQL (для подключения извне контейнера)
EXTERNAL_POSTGRES_PORT=${BONUS_EXTERNAL_POSTGRES_PORT}

# Имя пользователя для подключения к PostgreSQL
POSTGRES_USER=${BONUS_POSTGRES_USER}

# Пароль пользователя для подключения к PostgreSQL
POSTGRES_PASSWORD=${BONUS_POSTGRES_PASSWORD}

# Название базы данных
POSTGRES_DB=${BONUS_POSTGRES_DB}

# Режим подключения по SSL (например, disable, require)
POSTGRES_SSL_MODE=${BONUS_POSTGRES_SSL_MODE}

# Путь к директории с миграциями
MIGRATION_DIRECTORY=${BONUS_MIGRATION_DIRECTORY}

# ----------------------------
# Настройки JWT
# ----------------------------


# SECRET
JWT_SECRET=${BONUS_JWT_SECRET}

# Время жизни токена
JWT_TTL=${BONUS_JWT_TTL}

# ----------------------------
# Настройки Accrual Системы
# ----------------------------

# Адрес системы вознаграждений
ACCRUAL_SYSTEM_ADDRESS=${BONUS_ACCRUAL_SYSTEM_ADDRESS}

# Сколько запросов может обрабатываться одновременно
ACCRUAL_WORKERS_COUNT=${BONUS_ACCRUAL_WORKERS_COUNT}