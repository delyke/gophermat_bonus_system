# -----------------------------------------
# BONUS СЕРВИС
# -----------------------------------------

# HTTP сервер
BONUS_HTTP_HOST=localhost
BONUS_HTTP_PORT=8080
BONUS_HTTP_READ_TIMEOUT=5s

# Логгер
BONUS_LOGGER_LEVEL=info
BONUS_LOGGER_AS_JSON=true

# PostgreSQL
BONUS_POSTGRES_HOST=localhost
BONUS_POSTGRES_PORT=5435
BONUS_EXTERNAL_POSTGRES_PORT=5435
BONUS_POSTGRES_USER=bonus-service-user
BONUS_POSTGRES_PASSWORD=bonus-service-password
BONUS_POSTGRES_DB=bonus-service
BONUS_POSTGRES_SSL_MODE=disable
BONUS_MIGRATION_DIRECTORY=./migrations

# JWT
BONUS_JWT_SECRET=bonus-service-jwt-secret
BONUS_JWT_TTL=1d

# ACCRUAL внешняя система начисления баллов
BONUS_ACCRUAL_SYSTEM_ADDRESS=http://localhost:8081
BONUS_ACCRUAL_WORKERS_COUNT=4